{
  "name": "@otrust/react",
  "version": "1.0.0",
  "description": "React components for OTRUST timestamping, proof verification, and issuer-gated Auth",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@otrust/sdk": "file:../sdk-js"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "vite": "^8.2.0",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "picomatch": "^4.0.4",
      "postcss": "8.5.25",
      "rollup": "^4.60.4",
      "vite": "^8.2.0",
      "ws": "^8.21.0"
    }
  },
  "keywords": [
    "otrust",
    "react",
    "authentication",
    "login",
    "identity",
    "timestamp",
    "proof",
    "zero-knowledge"
  ],
  "author": "OTRUST",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/otrust-eu/opensource.git",
    "directory": "sdk-react"
  },
  "homepage": "https://www.otrust.eu/docs#sdk",
  "bugs": {
    "url": "https://github.com/otrust-eu/opensource/issues"
  }
}
