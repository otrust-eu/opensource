# OTRUST Environment Configuration
# Copy this to .env and fill in your values

# Persistent SQLite file. Use a durable volume in production.
OTRUST_DB_PATH=./data/otrust.sqlite

# Server port
PORT=3000

# Node environment
NODE_ENV=development

# OpenTimestamps CLI for real Bitcoin anchoring.
# Install opentimestamps-client so `ots` is available, or set an explicit path.
# OTS_CLI_COMMAND=ots
# OTS_CLI_TIMEOUT_MS=120000

# ============================================
# EMAIL CONFIGURATION (choose one method)
# ============================================

# Option 1: Resend API (recommended for production)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Option 2: SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ============================================
# OTRUST SIGN - Email Signing Feature
# ============================================

# Secret for email webhook authentication (generate with: openssl rand -hex 32)
# EMAIL_SIGN_WEBHOOK_SECRET=

# Platform admin — orgs, API keys (generate with: openssl rand -hex 32)
# Required for /developers.html and POST /api/v1/platform/*
ADMIN_KEY=

# Stable secret for hosted auth tokens (generate with: openssl rand -hex 32)
# Required in production so auth tokens survive process restarts.
AUTH_SECRET=

# Public URL of your instance (webhooks, proof links)
# BASE_URL=https://otrust.yourcompany.com

# otrust.eu hosted service only — do NOT set on self-host (enables plan limits)
# HOSTED_MODE=true

# Unsafe development-only compatibility for retired self-attested identity records.
# Never enable this as identity verification; records cannot be used for auth.
# ENABLE_LEGACY_SELF_ATTESTED_IDENTITY=true

# Future issuer-bound identity integration gate. Do not enable without a
# server-validated credential issuance path.
# TRUSTED_IDENTITY_ISSUER_ENABLED=true
#
# Exact Auth redirect allowlist. Required before identity_auth becomes ready.
# AUTH_CLIENTS_JSON={"partner_prod":{"redirectUris":["https://partner.example/auth/callback"]}}

# Email to receive abuse reports
# ADMIN_EMAIL=admin@yourdomain.com

# ============================================
# SECURITY NOTES
# ============================================
# - Never commit .env files to git
# - Use strong random secrets (min 32 chars)
# - The app never logs IP addresses - privacy by design
# - All secrets should be set via environment variables
